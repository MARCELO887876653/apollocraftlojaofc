{
  "openapi": "3.1.0",
  "info": {
    "title": "Apollo Craft — API v1",
    "version": "1.0.0",
    "description": "API própria de entregas automáticas e catálogo bidirecional para addons Minecraft Bedrock. Autenticação por `Authorization: Bearer sk_live_...` ou `X-Api-Key` (BDS). Erros no formato { errors: [{ message, code }] }."
  },
  "servers": [{ "url": "https://tidy-mandrill-432.convex.site/api/v1", "description": "HTTP actions do Convex (backend de produção da loja)" }],
  "security": [{ "bearerAuth": [] }, { "apiKeyAuth": [] }],
  "components": {
    "securitySchemes": {
      "bearerAuth": { "type": "http", "scheme": "bearer" },
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-Api-Key" }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "message": { "type": "string" },
                "code": { "type": "string" }
              },
              "required": ["message", "code"]
            }
          }
        }
      },
      "ContentsPreview": {
        "type": "array",
        "description": "Somente exibição — nunca usado para reconstruir a entrega.",
        "items": {
          "type": "object",
          "properties": {
            "type_id": { "type": "string" },
            "name": { "type": "string" },
            "amount": { "type": "integer" }
          },
          "required": ["type_id"]
        }
      },
      "DeliveryAction": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "id estável da ação" },
          "type": { "type": "string" },
          "mode": { "type": "string", "enum": ["SERVER", "LOCAL_REFERENCE"] },
          "reference_id": { "type": "string", "description": "Kit/item mantido no addon." },
          "reference_revision": { "type": "integer" },
          "contents_preview": { "$ref": "#/components/schemas/ContentsPreview" },
          "quantity_mode": { "type": "string", "enum": ["MULTIPLY", "REPEAT", "IGNORE"] },
          "payload": {},
          "command": { "type": "string" },
          "offline_execute": { "type": "boolean" },
          "server_id": { "type": "string" },
          "addon_id": { "type": "string" },
          "delay_seconds": { "type": "number" },
          "reverse_action": { "type": "string" },
          "reverse_payload": {},
          "reverse_delay_seconds": { "type": "number" }
        },
        "required": ["type"]
      },
      "DeliveryRecipe": {
        "type": "object",
        "properties": {
          "version": { "type": "integer", "enum": [1] },
          "offline_execute": { "type": "boolean" },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 25,
            "items": { "$ref": "#/components/schemas/DeliveryAction" }
          },
          "expected_revision": { "type": "integer" }
        },
        "required": ["actions"]
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "external_id": { "type": ["string", "null"] },
          "revision": { "type": "integer" },
          "position": { "type": "integer" },
          "enabled": { "type": "boolean" },
          "archived": { "type": "boolean" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "slug": { "type": "string" },
          "price_cents": { "type": "integer" },
          "external_id": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["DRAFT", "PUBLISHED"] },
          "revision": { "type": "integer" },
          "delivery": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "enum": ["NONE", "SERVER", "LOCAL_REFERENCE"] },
              "reference_id": { "type": ["string", "null"] },
              "reference_revision": { "type": ["integer", "null"] },
              "has_local_reference": { "type": "boolean" }
            }
          },
          "delivery_recipe": { "$ref": "#/components/schemas/DeliveryRecipe" }
        }
      },
      "QueuedCommand": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "server_id": { "type": "string" },
          "addon_id": { "type": "string" },
          "action": { "type": "string" },
          "action_id": { "type": ["string", "null"] },
          "step_index": { "type": ["integer", "null"] },
          "mode": { "type": "string" },
          "reference_id": { "type": ["string", "null"] },
          "reference_revision": { "type": ["integer", "null"] },
          "payload": {},
          "status": { "type": "string", "enum": ["PENDING", "PROCESSING", "DONE", "FAILED", "CANCELED"] },
          "attempts": { "type": "integer" },
          "claim_token": { "type": "string" },
          "order": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "client_identifier": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/app/me": {
      "get": {
        "summary": "Handshake da integração (Testar conexão)",
        "tags": ["Conexão"],
        "responses": {
          "200": {
            "description": "Informações da chave e capacidades",
            "content": { "application/json": { "schema": { "type": "object", "properties": {
              "api_version": { "type": "string" },
              "authenticated": { "type": "boolean" },
              "key": { "type": "object" },
              "binding": { "type": "object" },
              "server_time": { "type": "string" },
              "capabilities": { "type": "object" }
            } } } }
          },
          "401": { "description": "Chave ausente/inválida", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/app/queued_commands": {
      "get": {
        "summary": "Lista entregas PENDING (compatibilidade; prefira claim)",
        "tags": ["Entregas"],
        "parameters": [
          { "name": "addon_id", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 200 } }
        ],
        "responses": { "200": { "description": "Lista de comandos", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/QueuedCommand" } } } } } }
      }
    },
    "/app/queued_commands/claim": {
      "post": {
        "summary": "Reserva atômica de entregas (recomendado)",
        "tags": ["Entregas"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "limit": { "type": "integer" }, "addon_id": { "type": "string" } } } } } },
        "responses": { "200": { "description": "Entregas reservadas com claim_token" } }
      }
    },
    "/app/command/{id}": {
      "patch": {
        "summary": "Confirmar entrega (DONE/FAILED/PENDING/CANCELED)",
        "tags": ["Entregas"],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": {
          "status": { "type": "string", "enum": ["DONE", "FAILED", "PENDING", "CANCELED"] },
          "claim_token": { "type": "string" },
          "response": { "type": "string" },
          "reason": { "type": "string" },
          "error_code": { "type": "string", "enum": ["PLAYER_OFFLINE", "HANDLER_NOT_FOUND", "REFERENCE_NOT_FOUND", "REFERENCE_REVISION_NOT_FOUND", "INVALID_PAYLOAD", "TEMPORARY_STORAGE_ERROR", "MAX_ATTEMPTS_REACHED"] },
          "retryable": { "type": "boolean" }
        }, "required": ["status"] } } } },
        "responses": {
          "200": { "description": "Confirmado" },
          "409": { "description": "CLAIM_INVALID / CLAIM_EXPIRED", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/app/user_queue/{user-id}": {
      "get": {
        "summary": "Entregas prontas de um jogador",
        "tags": ["Entregas"],
        "parameters": [{ "name": "user-id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/app/user_schedules/{user-id}": {
      "get": {
        "summary": "Entregas futuras de um jogador",
        "tags": ["Entregas"],
        "parameters": [{ "name": "user-id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Lista" } }
      }
    },
    "/app/heartbeat": {
      "post": {
        "summary": "Heartbeat do servidor/addon",
        "tags": ["Servidor"],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": {
          "server_id": { "type": "string" },
          "addon_version": { "type": "string" },
          "minecraft_version": { "type": "string" },
          "api_client_version": { "type": "string" },
          "capabilities": { "type": "object" },
          "error_code": { "type": "string" }
        } } } } },
        "responses": { "200": { "description": "Registrado" } }
      }
    },
    "/categories": {
      "get": { "summary": "Lista categorias", "tags": ["Categorias"], "responses": { "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Category" } } } } } } },
      "post": { "summary": "Cria categoria", "tags": ["Categorias"], "responses": { "201": { "description": "Criada" }, "200": { "description": "Idempotente" } } }
    },
    "/categories/upsert": {
      "post": { "summary": "Cria ou atualiza categoria por external_id", "tags": ["Categorias"], "responses": { "201": { "description": "Criada" }, "200": { "description": "Atualizada" } } }
    },
    "/categories/{id}": {
      "get": { "summary": "Obtém categoria (id/external_id/slug)", "tags": ["Categorias"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Categoria" }, "404": { "description": "Não encontrada" } } },
      "patch": { "summary": "Atualiza categoria (aceita expected_revision)", "tags": ["Categorias"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Atualizada" }, "409": { "description": "SYNC_CONFLICT" } } },
      "delete": { "summary": "Arquiva categoria (soft delete)", "tags": ["Categorias"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Arquivada" } } }
    },
    "/products": {
      "get": { "summary": "Lista produtos", "tags": ["Produtos"], "responses": { "200": { "description": "Lista", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Product" } } } } } } },
      "post": { "summary": "Cria produto", "tags": ["Produtos"], "responses": { "201": { "description": "Criado" }, "200": { "description": "Idempotente" } } }
    },
    "/products/upsert": {
      "post": { "summary": "Cria ou atualiza produto por external_id", "tags": ["Produtos"], "responses": { "201": { "description": "Criado" }, "200": { "description": "Atualizado" } } }
    },
    "/products/{id}": {
      "get": { "summary": "Obtém produto", "tags": ["Produtos"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Produto" }, "404": { "description": "Não encontrado" } } },
      "patch": { "summary": "Atualiza produto (aceita expected_revision)", "tags": ["Produtos"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Atualizado" }, "409": { "description": "SYNC_CONFLICT" } } },
      "delete": { "summary": "Arquiva produto (soft delete)", "tags": ["Produtos"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Arquivado" } } }
    },
    "/products/{id}/publish": {
      "post": { "summary": "Publica produto", "tags": ["Produtos"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Publicado" } } }
    },
    "/products/{id}/unpublish": {
      "post": { "summary": "Despublica produto", "tags": ["Produtos"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Despublicado" } } }
    },
    "/products/{id}/delivery-recipe": {
      "get": { "summary": "Lê a receita de entrega", "tags": ["Receita"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Receita", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryRecipe" } } } } } },
      "put": { "summary": "Define a receita de entrega", "tags": ["Receita"], "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryRecipe" } } } }, "responses": { "200": { "description": "Definida" }, "422": { "description": "INVALID_DELIVERY_RECIPE" } } }
    },
    "/sync/changes": {
      "get": {
        "summary": "Sincronização incremental (cursor + tombstones)",
        "tags": ["Sync"],
        "parameters": [
          { "name": "cursor", "in": "query", "schema": { "type": "string" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 200 } }
        ],
        "responses": { "200": { "description": "Mudanças desde o cursor" } }
      }
    },
    "/files/upload-url": {
      "post": { "summary": "URL de upload de imagem", "tags": ["Arquivos"], "responses": { "200": { "description": "upload_url" } } }
    },
    "/files/finalize": {
      "post": { "summary": "Finaliza upload de imagem", "tags": ["Arquivos"], "responses": { "200": { "description": "url" } } }
    }
  },
  "tags": [
    { "name": "Conexão" },
    { "name": "Entregas" },
    { "name": "Servidor" },
    { "name": "Categorias" },
    { "name": "Produtos" },
    { "name": "Receita" },
    { "name": "Sync" },
    { "name": "Arquivos" }
  ]
}
